def analysoi_tuotanto(tuotanto):
    yhteensa = 0

    for maara in tuotanto:
        yhteensa = yhteensa + maara
    return yhteensa

#paaohjelma

tuotanto = [120, 150, 90, 180, 160]

kokonaismaara = analysoi_tuotanto(tuotanto)
keskiarvo = kokonaismaara / len(tuotanto)

print("Tuotantomäärät: ", tuotanto)
print("Tuotanto yhteensä: ", kokonaismaara, "kpl")
print("Keskimääräinen päivätuotanto: ", keskiarvo, "kpl")